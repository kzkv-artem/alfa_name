# Скопируйте этот файл в .env и подставьте свой ключ.
# Файл .env в git не попадает — он в .gitignore.

# Провайдер: deepseek или openrouter
LLM_PROVIDER=deepseek

# Ключ выбранного провайдера
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- всё ниже необязательно, значения по умолчанию заданы в коде ---

# Своя модель. Для DeepSeek: deepseek-chat, deepseek-reasoner
# Для OpenRouter: deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
# LLM_MODEL=deepseek-chat

# Свой адрес эндпоинта — например, внутренний шлюз банка
# LLM_BASE_URL=https://api.deepseek.com/v1

# Параметры генерации и надёжности
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=3

# --- Демо-режим (только для api/) ---
# Включает воспроизведение LLM-ответов из demo_fixtures.json вместо живых
# вызовов — на защите не зависим от квоты/доступности провайдера. Детерминированная
# часть (CatBoost, скоринг страхования, подбор программ, риск-скор) всегда считается
# по-настоящему, DEMO_MODE её не подменяет. Записать/обновить фикстуры:
# ./.venv/Scripts/python.exe scripts/record_fixtures.py (нужен настоящий ключ выше).
# DEMO_MODE=1
# DEMO_FIXTURES_PATH=demo_fixtures.json

# --- Кэш LLM-ответов (только для api/, включён по умолчанию) ---
# Ключ — тот же хэш пары (system, user), что у DEMO_MODE. При повторном
# запросе с точно таким же промптом ответ берётся из кэша без сетевого
# вызова — экономит дневной лимит провайдера. При промахе кэша идёт
# настоящий вызов (в отличие от DEMO_MODE — не заглушка). Файл переживает
# перезапуск сервера. Не действует вместе с DEMO_MODE (там живых вызовов и
# так нет). Выключить: LLM_CACHE=0.
# LLM_CACHE=1
# LLM_CACHE_PATH=llm_cache.json
